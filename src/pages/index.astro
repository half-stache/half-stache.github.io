---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Evidence from '../components/Evidence.astro';
import WorkRow from '../components/WorkRow.astro';
import Music from '../components/Music.astro';
import { projects } from '../data/projects';
import { site } from '../data/site';
---
<Base>
  <Hero />

  <section id="short" class="section" aria-labelledby="short-title">
    <div class="wrap">
      <header class="section__head" data-reveal>
        <h2 id="short-title" class="section__title">The short version</h2>
      </header>
      <Evidence />
    </div>
  </section>

  <section id="work" class="section" aria-labelledby="work-title">
    <div class="wrap">
      <header class="section__head" data-reveal>
        <h2 id="work-title" class="section__title">Work</h2>
        <p class="section__note">Only finished or actively used work is here.</p>
      </header>
      <div class="work">
        {projects.map((p, i) => <WorkRow project={p} index={i} />)}
      </div>
    </div>
  </section>

  <section id="music" class="section" aria-labelledby="music-title">
    <div class="wrap">
      <header class="section__head" data-reveal>
        <h2 id="music-title" class="section__title">Music</h2>
      </header>
      <Music />
    </div>
  </section>

  <section id="listening" class="section" aria-labelledby="listen-title">
    <div class="wrap">
      <header class="section__head" data-reveal>
        <h2 id="listen-title" class="section__title">Listening</h2>
      </header>
      <div data-reveal>
        <blockquote class="verse">
          <p>Speak, for your servant hears.</p>
          <cite>1 Samuel 3:10</cite>
        </blockquote>
        <p class="listen__text">Listening first. Know the heart of the customer, then apply technical wisdom to it. That is the whole method.</p>
        <p class="listen__text">Client work runs through {site.company}.</p>
      </div>
    </div>
  </section>

  <section id="contact" class="section" aria-labelledby="contact-title">
    <div class="wrap">
      <header class="section__head" data-reveal>
        <h2 id="contact-title" class="section__title">Contact</h2>
      </header>
      <div data-reveal>
        <a class="contact__email" href={`mailto:${site.email}`}>{site.email}</a>
        <div class="contact__links">
          <a class="pill" href={site.github}>GitHub ↗</a>
          <a class="pill" href={site.spotify}>Spotify ↗</a>
          {site.youtube && <a class="pill" href={site.youtube}>YouTube ↗</a>}
        </div>
      </div>
    </div>
  </section>
</Base>
<script>
  import { initMotion } from '../scripts/motion';
  initMotion();
</script>
