---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import WorkRow from '../components/WorkRow.astro';
import Music from '../components/Music.astro';
import { projects } from '../data/projects';
import { about } from '../data/about';
import { site } from '../data/site';
---
<Base jsonLd>
  <Hero />

  <section id="about" class="section" aria-labelledby="about-title">
    <div class="wrap section__grid">
      <h2 id="about-title" class="section__title" data-reveal>About</h2>
      <div class="prose" data-reveal>
        {about.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section id="work" class="section" aria-labelledby="work-title">
    <div class="wrap">
      <div class="section__grid">
        <h2 id="work-title" class="section__title" data-reveal>Work</h2>
        <p class="prose" data-reveal>Everything here is finished or in daily use.</p>
      </div>
      <div class="projects">
        {projects.map((p, i) => <WorkRow project={p} index={i} />)}
      </div>
    </div>
  </section>

  <section id="music" class="section" aria-labelledby="music-title">
    <div class="wrap section__grid">
      <h2 id="music-title" class="section__title" data-reveal>Music</h2>
      <Music />
    </div>
  </section>

  <section id="listening" class="section" aria-labelledby="listen-title">
    <div class="wrap section__grid">
      <h2 id="listen-title" class="section__title" data-reveal>How I work</h2>
      <div class="prose" data-reveal>
        <blockquote class="verse">
          <p>Speak, for your servant hears.</p>
          <cite>1 Samuel 3:10</cite>
        </blockquote>
        <p>Listening comes first. I try to know the heart of the customer and then apply technical wisdom to it, and that is the whole method.</p>
        <p>Client work runs through {site.company}. If you have a project in mind, write to <a class="link" href={`mailto:${site.email}`}>{site.email}</a>.</p>
      </div>
    </div>
  </section>

  <section id="contact" class="section" aria-labelledby="contact-title">
    <div class="wrap section__grid">
      <h2 id="contact-title" class="section__title" data-reveal>Contact</h2>
      <div class="prose" data-reveal>
        <p><a class="contact__email" href={`mailto:${site.email}`}>{site.email}</a></p>
        <p>I’m also on <a class="link" href={site.github}>GitHub</a> and <a class="link" href={site.spotify}>Spotify</a>{site.youtube && <> and <a class="link" href={site.youtube}>YouTube</a></>}.</p>
      </div>
    </div>
  </section>
</Base>
<script>
  import { initMotion } from '../scripts/motion';
  initMotion();
</script>
