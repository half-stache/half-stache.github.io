---
import Mark from './Mark.astro';
import { site } from '../data/site';
---
<footer class="site-foot">
  <div class="wrap site-foot__in">
    <p class="site-foot__brand">
      <Mark size={22} decorative />
      <span>{site.identity}</span>
    </p>
    <nav aria-label="Footer">
      <a href="/#work">Work</a>
      <a rel="me" href={site.github}>GitHub</a>
      <a rel="me" href={site.spotify}>Spotify</a>
      {site.youtube && <a rel="me" href={site.youtube}>YouTube</a>}
      <a href="/brand/">Brand</a>
      <a href="/privacy.html">LavaRise privacy policy</a>
      <a href="#top">Back to top</a>
    </nav>
    <p class="site-foot__fine">Built with Astro and hosted on GitHub Pages. No analytics and no cookies. The Spotify player loads only when you ask for it.</p>
  </div>
</footer>
