---
import Mark from './Mark.astro';
import { site } from '../data/site';
---
<footer class="site-foot">
  <div class="wrap site-foot__in">
    <p class="site-foot__brand">
      <Mark size={22} decorative />
      <span>half-stache is {site.fullName}. Client work: {site.company}.</span>
    </p>
    <nav aria-label="Footer">
      <a href={site.github}>GitHub</a>
      <a href={site.spotify}>Spotify</a>
      <a href="/privacy.html">LavaRise privacy policy</a>
    </nav>
    <p class="site-foot__fine">Built with Astro. Hosted on GitHub Pages. No analytics, no cookies. The Spotify player loads only when you ask for it.</p>
  </div>
</footer>
