---
import { site } from '../data/site';
import { music } from '../data/home';
const embed = `https://open.spotify.com/embed/artist/${site.spotifyId}?utm_source=generator&theme=0`;
---
<div class="music">
  <div class="music__text" data-reveal>
    <p>{music.text}</p>
    <p><a class="link" rel="me" href={site.spotify}>Listen on Spotify</a>{site.youtube && <> or <a class="link" rel="me" href={site.youtube}>watch on YouTube</a></>}.</p>
  </div>
  <div class="music__embed" data-reveal data-embed={embed}>
    <button class="music__cta" type="button" data-load-embed>Load the Spotify player</button>
  </div>
</div>
