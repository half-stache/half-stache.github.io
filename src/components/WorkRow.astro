---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Project } from '../data/projects';
import RiverDiagram from './RiverDiagram.astro';
import LavaTile from './LavaTile.astro';

interface Props { project: Project; index: number }
const { project, index } = Astro.props;
const { title, kind, text, link, aside, media } = project;

const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/work/*.webp', { eager: true });
const image = media.image ? shots[`../assets/work/${media.image}.webp`]?.default : undefined;
---
<article class="project" id={project.slug}>
  <div class="project__media" data-reveal>
    {media.special === 'river' && <RiverDiagram />}
    {media.special === 'lava' && <LavaTile />}
    {image && (
      <div class="shot">
        <Image src={image} alt={`The ${title} website`} widths={[720, 1200, 1600]} sizes="(min-width: 76rem) 76rem, 100vw" loading={index === 0 ? 'eager' : 'lazy'} />
      </div>
    )}
  </div>
  <div class="project__text" data-reveal>
    <div>
      <h3 class="project__title">{title}</h3>
      <p class="project__kind">{kind}</p>
    </div>
    <div class="project__body">
      <p>{text}</p>
      {link && <p><a class="link" href={link.url}>{link.label}</a></p>}
      {aside && <p class="project__aside">{aside}</p>}
    </div>
  </div>
</article>
