---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Project } from '../data/projects';
import RiverDiagram from './RiverDiagram.astro';
import AppStoreBadge from './AppStoreBadge.astro';

interface Props { project: Project; index: number }
const { project, index } = Astro.props;
const { title, kind, text, link, aside, media, icon, appStore } = project;
const page = `/work/${project.slug}/`;

const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/work/*.webp', { eager: true });
const pick = (stem?: string) => (stem ? shots[`../assets/work/${stem}.webp`]?.default : undefined);
const image = pick(media.image);
const phones = (media.phones ?? []).map(pick).filter(Boolean) as ImageMetadata[];
const iconImg = pick(icon);
// The App Store badge replaces a plain link that would point at the same listing.
const plainLink = link && link.url !== appStore ? link : undefined;
---
<article class="project" id={project.slug}>
  <div class="project__media" data-reveal>
    {media.special === 'river' && <RiverDiagram />}
    {phones.length > 0 && (
      <div class="phones">
        {phones.map((ph, i) => (
          <div class="phone">
            <Image src={ph} alt={`${title} on iPhone, screen ${i + 1} of ${phones.length}`} widths={[320, 480, 640]} sizes="(min-width: 56em) 24rem, 70vw" loading={index === 0 ? 'eager' : 'lazy'} />
          </div>
        ))}
      </div>
    )}
    {image && (
      <div class="shot">
        <Image src={image} alt={`The ${title} website`} widths={[720, 1200, 1600]} sizes="(min-width: 76rem) 76rem, 100vw" loading={index === 0 ? 'eager' : 'lazy'} />
      </div>
    )}
  </div>
  <div class="project__text" data-reveal>
    <div>
      {iconImg && <Image class="project__icon" src={iconImg} alt={`The ${title} app icon`} width={96} height={96} loading="lazy" />}
      <h3 class="project__title"><a href={page}>{title}</a></h3>
      <p class="project__kind">{kind}</p>
    </div>
    <div class="project__body">
      <p>{text}</p>
      {plainLink && <p><a class="link" href={plainLink.url}>{plainLink.label}</a></p>}
      {appStore && <p><AppStoreBadge href={appStore} name={title} /></p>}
      <p><a class="link" href={page}>More about {title}</a></p>
      {aside && <p class="project__aside">{aside}</p>}
    </div>
  </div>
</article>
