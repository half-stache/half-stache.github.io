---
import type { CollectionEntry } from 'astro:content';
import StatusPill from './StatusPill.astro';
interface Props { project: CollectionEntry<'projects'>; number: number }
const { project, number } = Astro.props;
const { title, summary, stack, status, statusNote } = project.data;
const num = String(number).padStart(2, '0');
---
<li class="card" data-reveal>
  <a class="card__link" href={`/work/${project.id}/`}>
    <span class="card__num" aria-hidden="true">{num}</span>
    <span class="card__body">
      <span class="card__title">{title}</span>
      <span class="card__summary">{summary}</span>
      <span class="card__meta">
        <StatusPill status={status} note={statusNote} />
        <span>{stack.slice(0, 4).join(' · ')}</span>
      </span>
    </span>
    <span class="card__arrow" aria-hidden="true">→</span>
  </a>
</li>
