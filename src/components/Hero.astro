---
import Mark from './Mark.astro';
import { site } from '../data/site';
---
<section class="hero" id="top">
  <canvas class="hero__canvas" id="hero-canvas" aria-hidden="true"></canvas>
  <div class="wrap hero__in">
    <div class="hero__mark" data-hero>
      <Mark size={200} label="half-stache: a mustache, red on the left, white on the right" />
    </div>
    <p class="eyebrow" data-hero>half-stache</p>
    <h1 class="display hero__title" data-hero>{site.fullName}</h1>
    <p class="hero__line" data-hero>Apps, websites, a river model, and music.</p>
    <p data-hero><a class="hero__down" href="#short">The short version ↓</a></p>
  </div>
</section>
<script>
  import { mountHero } from '../scripts/hero-canvas';
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
  if (canvas) mountHero(canvas);
</script>
